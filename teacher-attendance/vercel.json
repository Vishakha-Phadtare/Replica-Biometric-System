{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.3" },
    { "src": "api/*.php", "use": "vercel-php@0.7.3" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "models/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin/login", "dest": "/index.php" },
    { "src": "/admin/dashboard", "dest": "/dashboard.php" },
    { "src": "/admin", "dest": "/dashboard.php" },
    { "src": "/teacher/login", "dest": "/teacher_login.php" },
    { "src": "/teacher/signup", "dest": "/teacher_signup.php" },
    { "src": "/teacher/dashboard", "dest": "/teacher_dashboard.php" },
    { "src": "/teacher/attendance", "dest": "/teacher_attendance.php" },
    { "src": "/teacher", "dest": "/teacher_dashboard.php" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
